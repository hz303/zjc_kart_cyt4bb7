<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 本工程全部用代码构建界面、不使用 WinForms 设计器，
         因此关掉「自定义控件属性需可被设计器序列化」这条分析规则 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>KartHost</AssemblyName>
    <RootNamespace>KartHost</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Product>卡丁快跑 上位机</Product>
    <AssemblyTitle>KartHost</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- 路表管理（Ui/RouteManagerForm.cs）走 DAP 自带的虚拟串口灌表 / 读表。
         车端对应 ins_route/code/route_link.c（UART_0）。版本与
         A_zjc_project/2.1imu_for_trails_pc 保持一致（那边已经用同一个版本）。 -->
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

</Project>
